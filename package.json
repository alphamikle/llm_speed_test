    "postinstall": "node scripts/postinstall.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "ajv": "8.20.0",
    "commander": "14.0.3",
    "playwright": "1.65.1",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alphamikle/llm_speed_test.git"
  },
  "license": "MIT"
