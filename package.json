{
  "name": "sllm",
  "version": "0.1.0",
  "description": "Reproducible multilingual LLM inference and coding-agent benchmarks",
  "type": "module",
  "bin": {
    "sllm": "bin/sllm.js"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "files": [
    "bin",
    "src",
    "data",
    "docs",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
